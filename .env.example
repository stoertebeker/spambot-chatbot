# Telegram API Credentials (from https://my.telegram.org)
# Go to my.telegram.org -> API development tools -> Create application
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# LLM Configuration
# For OpenAI-compatible endpoints (like LiteLLM proxy):
LITELLM_MODEL=openai/claude-haiku-4.5
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://your-llm-endpoint.com/v1

# Alternative: Direct OpenAI
# LITELLM_MODEL=gpt-3.5-turbo
# OPENAI_API_KEY=sk-your-openai-key-here

# Alternative: Direct Anthropic
# LITELLM_MODEL=claude-3-haiku-20240307
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Alternative: Local LLM (Ollama)
# LITELLM_MODEL=ollama/llama2
# No API key needed for local models

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
