# Telegram Bot Token (von @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Deine Telegram User ID (um nur dir zu erlauben, den Bot zu steuern)
ADMIN_USER_ID=your_telegram_user_id

# LiteLLM API Einstellungen
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_API_BASE=your_api_base_url_here
LITELLM_MODEL=your_model_name_here

# Optional: Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Andere LLM Provider (falls du nicht LiteLLM verwendest)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
